# Server
PORT=5000

# Browser origins allowed to call this API, comma separated.
# Leave empty for local development. Set it in production, for example:
# CORS_ORIGIN=https://campuspulse.example.edu
CORS_ORIGIN=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campuspulse
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Managed Postgres (Render, Neon, Railway, Supabase) needs TLS. Set to true there.
DB_SSL=false

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# AI layer
# Leave PYTHON_BIN empty to use ai/.venv, or point it at a specific python
PYTHON_BIN=
# How long one analysis may take before it is abandoned and the script restarted.
# The Python scripts are kept running, so a warm analysis takes well under a second.
AI_TIMEOUT_MS=10000

# Gemini (GenAI). Only used for complaint summaries and response drafts, and only
# from the backend: this key is never sent to the React app.
# Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini text model works. Leave empty to use the default.
# gemini-2.5-flash has been retired for new API keys.
GEMINI_MODEL=gemini-3.6-flash

# Image storage (Cloudinary). With all three set, complaint photos are uploaded to
# Cloudinary and only the URL is kept in the database, which is what a host with an
# ephemeral disk needs. Left empty, the images stay on local disk under server/uploads/.
# Get these from the Cloudinary dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
